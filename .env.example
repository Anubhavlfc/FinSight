# FinSight AI configuration. Copy to .env for local use; never commit real values.
# Nothing here is read by the browser: API keys stay on the server.

# --- Data source -------------------------------------------------------------------------
# Required for live analyses. SEC asks automated clients to identify themselves with an
# app or person name and a contact address. Without it only the synthetic sample runs.
FINSIGHT_SEC_USER_AGENT="Your App Name contact@your-domain.example"

# --- Investigator (optional) -------------------------------------------------------------
# Enables the Claude investigator and narrative review. Without it a rule-based
# investigator is used and labelled as such. Usage is billed by Anthropic.
# ANTHROPIC_API_KEY=
# FINSIGHT_LLM_MODEL=claude-opus-5-5
# "rule_based" keeps public visitors on the free investigator even when a key is set.
FINSIGHT_PUBLIC_INVESTIGATOR=auto

# --- Storage -----------------------------------------------------------------------------
# Base folder for the SQLite database, the SEC cache (.finsight/) and reports (out/).
# FINSIGHT_HOME=/data

# --- API server --------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
# Browser origins allowed to call the API when the frontend is hosted elsewhere
# (comma separated, no trailing slash). Leave empty when FastAPI serves the frontend.
# FINSIGHT_CORS_ORIGINS=https://your-name.github.io
# If set, approving a report requires this value in the X-Reviewer-Token header.
# FINSIGHT_REVIEWER_TOKEN=
# Number of reverse proxies in front of the server (0 = none). Used to find the visitor's
# address in X-Forwarded-For for rate limiting.
FINSIGHT_TRUSTED_PROXY_HOPS=0

# --- Limits ------------------------------------------------------------------------------
FINSIGHT_MAX_CONCURRENT_RUNS=2
FINSIGHT_MAX_QUEUED_RUNS=4
FINSIGHT_RUNS_PER_HOUR=6
FINSIGHT_LOOKUPS_PER_MINUTE=60
FINSIGHT_RUN_BUDGET_SECONDS=900

# --- Frontend build (web/.env, only when the frontend is hosted separately) ----------------
# VITE_BASE=/FinSight/
# VITE_API_BASE_URL=https://your-api.example.com
